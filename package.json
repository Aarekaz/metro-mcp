{
  "name": "metro-mcp",
  "version": "4.0.1",
  "description": "MCP server for US transit systems (DC Metro, NYC Subway) on Cloudflare Workers",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "echo 'no build step needed: wrangler bundles src/index.ts directly via esbuild. Type-check runs via `bun run type-check` locally or in a separate CI job.'",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "NODE_OPTIONS=--max-old-space-size=12288 tsc --noEmit",
    "type-check": "NODE_OPTIONS=--max-old-space-size=12288 tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "agents": "^0.20.1",
    "gtfs-realtime-bindings": "^2.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.0",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.1"
  },
  "keywords": [
    "mcp",
    "metro",
    "subway",
    "transit",
    "wmata",
    "mta",
    "dc",
    "nyc",
    "washington",
    "new-york",
    "cloudflare-workers",
    "gtfs",
    "real-time"
  ],
  "author": "Anurag Dhungana",
  "homepage": "https://anuragd.me",
  "engines": {
    "node": "^22.18.0 || >=24.11.0",
    "bun": ">=1.3.0"
  },
  "overrides": {
    "@hono/node-server": "^2.1.0",
    "body-parser": "^2.3.0",
    "fast-uri": "^3.1.5",
    "hono": "^4.13.1",
    "ip-address": "^10.5.0"
  },
  "license": "MIT"
}
